// How Bandicoot works: from a contact budget to a ranked contact list.
// Render: dot -Tsvg rmab-workflow.dot -o rmab-workflow.svg
digraph RMABWorkflow {
    graph [rankdir=LR, compound=true, newrank=true, bgcolor="#ffffff", pad="0.3",
           nodesep="0.25", ranksep="0.45", labelloc=t, labeljust=l,
           fontname="Helvetica,Arial,sans-serif", fontsize=10, fontcolor="#1f2937"];
    node  [shape=box, style="rounded,filled", penwidth=1.2, margin="0.16,0.07",
           fontname="Helvetica,Arial,sans-serif", fontsize=10, fontcolor="#1f2937",
           fillcolor="#ffffff", color="#94a3b8"];
    edge  [color="#64748b", penwidth=1.1, arrowsize=0.7,
           fontname="Helvetica,Arial,sans-serif", fontsize=9, fontcolor="#475569"];

    subgraph cluster_problem {
        label=<<b>The constraint</b>>;
        style="rounded,filled"; fillcolor="#fff1f2"; color="#fecdd3";
        node [fillcolor="#ffe4e6", color="#be123c"];
        participants [label=<<b>Many participants</b><br/><font point-size="9" color="#475569">engagement changes over time</font>>];
        budget       [label=<<b>Small contact budget</b><br/><font point-size="9" color="#475569">example: 1,000 calls per day</font>>];
        lapse        [label=<<b>Participants disengage</b><br/><font point-size="9" color="#475569">and drop out of the program</font>>];
    }

    subgraph cluster_bandicoot {
        label=<<b>Bandicoot</b>>;
        style="rounded,filled"; fillcolor="#f0fdfa"; color="#99f6e4";
        node [fillcolor="#ccfbf1", color="#0f766e"];
        group  [label=<<b>1. Cluster</b><br/><font point-size="9" color="#475569">group participants<br/>by behavior</font>>];
        learn  [label=<<b>2. Learn</b><br/><font point-size="9" color="#475569">transition probabilities<br/>per cluster</font>>];
        score  [label=<<b>3. Score</b><br/><font point-size="9" color="#475569">Whittle index per<br/>(cluster, state)</font>>];
        rank   [label=<<b>4. Rank</b><br/><font point-size="9" color="#475569">top-K participants<br/>within the budget</font>>];
    }

    subgraph cluster_outreach {
        label=<<b>Outreach</b>>;
        style="rounded,filled"; fillcolor="#fffbeb"; color="#fde68a";
        node [fillcolor="#fef3c7", color="#b45309"];
        contact [label=<<b>Contact the top K</b><br/><font point-size="9" color="#475569">call, SMS, visit, or check-in</font>>];
        measure [label=<<b>Measure with an A/B test</b><br/><font point-size="9" color="#475569">ranking vs. current method;<br/>new data feeds the next training</font>>];
    }

    budget -> group [ltail=cluster_problem];
    group -> learn -> score -> rank;
    rank -> contact -> measure;

    label=<<font point-size="15"><b>How Bandicoot works</b></font><br align="left"/><font point-size="10" color="#64748b">Spend a fixed contact budget on the participants where a contact changes the most.</font><br align="left"/>>;
}
