// How an outreach program maps to a restless multi-armed bandit (RMAB).
// Render: dot -Tsvg problem-modeling.dot -o problem-modeling.svg
digraph ProblemModeling {
    graph [rankdir=TB, compound=true, newrank=true, bgcolor="#ffffff", pad="0.3",
           nodesep="0.3", ranksep="0.4", labelloc=t, labeljust=l,
           fontname="Helvetica,Arial,sans-serif", fontsize=10, fontcolor="#1f2937"];
    node  [shape=box, style="rounded,filled", penwidth=1.2, margin="0.16,0.07",
           fontname="Helvetica,Arial,sans-serif", fontsize=10, fontcolor="#1f2937",
           fillcolor="#ffffff", color="#94a3b8"];
    edge  [color="#64748b", penwidth=1.1, arrowsize=0.7,
           fontname="Helvetica,Arial,sans-serif", fontsize=9, fontcolor="#475569"];

    mapping [shape=plain, label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="6" color="#cbd5e1" style="rounded">
          <tr><td align="left" bgcolor="#dbeafe"><b>In the program</b></td><td align="left" bgcolor="#ccfbf1"><b>In the RMAB model</b></td></tr>
          <tr><td align="left">A participant</td><td align="left">An arm, with its own Markov decision process</td></tr>
          <tr><td align="left" bgcolor="#f8fafc">Engaged or not in the last period</td><td align="left" bgcolor="#f8fafc">State s: Responsive (R) or Unresponsive (U)</td></tr>
          <tr><td align="left">Contact or no contact</td><td align="left">Action a: active or passive</td></tr>
          <tr><td align="left" bgcolor="#f8fafc">Behavior changes over time</td><td align="left" bgcolor="#f8fafc">Transition probabilities P(s′ | s, a)</td></tr>
          <tr><td align="left">Engagement is the goal</td><td align="left">Reward: +1 in R, −1 in U</td></tr>
          <tr><td align="left" bgcolor="#f8fafc">Contacts per period are limited</td><td align="left" bgcolor="#f8fafc">Budget: at most K active arms per step</td></tr>
        </table>>];

    subgraph cluster_solve {
        label=<<b>Bandicoot solves the model</b>>;
        style="rounded,filled"; fillcolor="#f0fdfa"; color="#99f6e4";
        node [fillcolor="#ccfbf1", color="#0f766e"];
        group [label=<<b>Cluster</b><br/><font point-size="9" color="#475569">k-means on passive<br/>transition probabilities</font>>];
        learn [label=<<b>Learn</b><br/><font point-size="9" color="#475569">Dirichlet-smoothed<br/>counts per cluster</font>>];
        score [label=<<b>Score</b><br/><font point-size="9" color="#475569">Whittle index per<br/>(cluster, state)</font>>];
        rank  [label=<<b>Rank</b><br/><font point-size="9" color="#475569">contact the K arms<br/>with the highest index</font>>];
        {rank=same; group; learn; score; rank}
        group -> learn -> score -> rank;
    }

    output [shape=plain, label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#b45309" bgcolor="#fef3c7" style="rounded">
          <tr><td align="left" colspan="4"><b>Output for one step</b>  <font point-size="9" color="#475569">(example, K = 3)</font></td></tr>
          <tr><td align="left"><font point-size="9" color="#475569">Rank</font></td><td align="left"><font point-size="9" color="#475569">Participant</font></td><td align="left"><font point-size="9" color="#475569">Cluster, state</font></td><td align="right"><font point-size="9" color="#475569">Index</font></td></tr>
          <tr><td align="left">1</td><td align="left">P-0412</td><td align="left">3, U</td><td align="right">1.21</td></tr>
          <tr><td align="left">2</td><td align="left">P-1290</td><td align="left">7, U</td><td align="right">1.05</td></tr>
          <tr><td align="left">3</td><td align="left">P-0077</td><td align="left">3, R</td><td align="right">0.76</td></tr>
        </table>>];

    mapping -> group [lhead=cluster_solve];
    rank -> output;
    output -> learn [style=dashed, constraint=false, label="observe the next state"];

    label=<<font point-size="15"><b>From program to model</b></font><br align="left"/><font point-size="10" color="#64748b">Each participant is one arm. The budget limits how many arms are active per step.</font><br align="left"/>>;
}
