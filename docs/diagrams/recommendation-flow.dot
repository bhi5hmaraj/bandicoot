// Request flow of POST /api/v1/recommend as built in app/api/routes.py.
// Render: dot -Tsvg recommendation-flow.dot -o recommendation-flow.svg
digraph RecommendationFlow {
    graph [rankdir=LR, newrank=true, bgcolor="#ffffff", pad="0.3",
           nodesep="0.3", ranksep="0.35", labelloc=t, labeljust=l,
           fontname="Helvetica,Arial,sans-serif", fontsize=10, fontcolor="#1f2937"];
    node  [shape=box, style="rounded,filled", penwidth=1.2, margin="0.14,0.08",
           fontname="Helvetica,Arial,sans-serif", fontsize=10, fontcolor="#1f2937",
           fillcolor="#ccfbf1", color="#0f766e"];
    edge  [color="#64748b", penwidth=1.1, arrowsize=0.7,
           fontname="Helvetica,Arial,sans-serif", fontsize=9, fontcolor="#475569"];

    request [fillcolor="#dbeafe", color="#2563eb", label=<<table border="0" cellspacing="1">
        <tr><td align="left"><b>POST /api/v1/recommend</b></td></tr>
        <tr><td align="left"><font point-size="9" color="#475569">budget, caregiver_ids,</font></td></tr>
        <tr><td align="left"><font point-size="9" color="#475569">current_states</font></td></tr>
        <tr><td align="left"><font point-size="9" color="#475569">header: X-API-Key</font></td></tr></table>>];

    check [label=<<table border="0" cellspacing="1">
        <tr><td align="left"><b>1. Check</b></td></tr>
        <tr><td align="left"><font point-size="9" color="#475569">API key (if auth is on)</font></td></tr>
        <tr><td align="left"><font point-size="9" color="#475569">model is fitted, else 400</font></td></tr></table>>];
    inputs [label=<<table border="0" cellspacing="1">
        <tr><td align="left"><b>2. Inputs</b></td></tr>
        <tr><td align="left"><font point-size="9" color="#475569">IDs and states from the request;</font></td></tr>
        <tr><td align="left"><font point-size="9" color="#475569">random mock data if absent</font></td></tr></table>>];
    lookup [label=<<table border="0" cellspacing="1">
        <tr><td align="left"><b>3. Look up</b></td></tr>
        <tr><td align="left"><font point-size="9" color="#475569">index of (cluster, state);</font></td></tr>
        <tr><td align="left"><font point-size="9" color="#475569">unknown participant: median</font></td></tr></table>>];
    select [label=<<table border="0" cellspacing="1">
        <tr><td align="left"><b>4. Select</b></td></tr>
        <tr><td align="left"><font point-size="9" color="#475569">top K by index</font></td></tr>
        <tr><td align="left"><font point-size="9" color="#475569">(numpy argpartition)</font></td></tr></table>>];

    response [fillcolor="#fef3c7", color="#b45309", label=<<table border="0" cellspacing="1">
        <tr><td align="left"><b>Response</b></td></tr>
        <tr><td align="left"><font point-size="9" color="#475569">ranked IDs, scores, states,</font></td></tr>
        <tr><td align="left"><font point-size="9" color="#475569">clusters, reason, metadata</font></td></tr></table>>];

    model [shape=cylinder, style=filled, fillcolor="#f1f5f9", color="#64748b",
           label=<<b>In-memory model</b><br/><font point-size="9" color="#475569">fitted BandicootRMAB</font>>];
    planned [style="rounded,dashed", fillcolor="#ffffff", color="#94a3b8", label=<<table border="0" cellspacing="1">
        <tr><td align="left"><b>Planned</b></td></tr>
        <tr><td align="left"><font point-size="9" color="#475569">read participants and states from storage</font></td></tr>
        <tr><td align="left"><font point-size="9" color="#475569">log each response; p95 latency target 500 ms</font></td></tr></table>>];

    request -> check -> inputs -> lookup -> select -> response;
    model -> lookup [style=dashed, arrowhead=none];
    {rank=same; lookup; model}
    {rank=same; inputs; planned}
    planned -> inputs [style=invis];

    label=<<font point-size="15"><b>Recommendation request</b></font><br align="left"/><font point-size="10" color="#64748b">What the service does for each call. Field names use the code's caregiver_id.</font><br align="left"/>>;
}
