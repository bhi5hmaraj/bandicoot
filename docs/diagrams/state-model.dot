// The 2-state MDP for one participant, with example transition probabilities.
// The Whittle index values come from bandicoot.core.whittle.compute_whittle_index
// for these example probabilities with gamma = 0.99.
// Render: dot -Tsvg state-model.dot -o state-model.svg
digraph StateModel {
    graph [rankdir=LR, bgcolor="#ffffff", pad="0.3", nodesep="0.5", ranksep="1.1",
           labelloc=t, labeljust=l,
           fontname="Helvetica,Arial,sans-serif", fontsize=10, fontcolor="#1f2937"];
    node  [shape=ellipse, style=filled, penwidth=1.4, margin="0.2,0.1",
           fontname="Helvetica,Arial,sans-serif", fontsize=10, fontcolor="#1f2937"];
    edge  [color="#64748b", penwidth=1.1, arrowsize=0.7,
           fontname="Helvetica,Arial,sans-serif", fontsize=9, fontcolor="#475569"];

    R [label=<<b>Responsive (R)</b><br/><font point-size="9" color="#475569">engaged in the last period</font><br/><font point-size="9" color="#475569">reward +1</font>>,
       fillcolor="#ccfbf1", color="#0f766e"];
    U [label=<<b>Unresponsive (U)</b><br/><font point-size="9" color="#475569">no engagement in the last period</font><br/><font point-size="9" color="#475569">reward −1</font>>,
       fillcolor="#ffe4e6", color="#be123c"];

    R -> R [label=<passive 0.60<br/><b>active 0.85</b>>, color="#0f766e"];
    R -> U [label=<passive 0.40<br/><b>active 0.15</b>>, color="#be123c"];
    U -> R [label=<passive 0.10<br/><b>active 0.50</b>>, color="#0f766e"];
    U -> U [label=<passive 0.90<br/><b>active 0.50</b>>, color="#be123c"];

    index [shape=plain, style="", label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#b45309" bgcolor="#fef3c7" style="rounded">
          <tr><td align="left" colspan="2"><b>Index from the solver</b>  <font point-size="9" color="#475569">(γ = 0.99)</font></td></tr>
          <tr><td align="left">W(R)</td><td align="right">0.76</td></tr>
          <tr><td align="left">W(U)</td><td align="right"><b>1.21</b></td></tr>
          <tr><td align="left" colspan="2"><font point-size="9" color="#475569">Contact participants in U first.</font></td></tr>
          <tr><td align="left" colspan="2"><font point-size="9" color="#475569">Textbook Whittle index for U: 1.57.</font></td></tr>
        </table>>];
    U -> index [style=invis];

    label=<<font point-size="15"><b>State model for one participant</b></font><br align="left"/><font point-size="10" color="#64748b">Edge labels give P(next state | state, action). Active = contact, passive = no contact. Values are examples.</font><br align="left"/>>;
}
