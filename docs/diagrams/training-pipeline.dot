// Planned weekly training job. Steps 1 to 4 call existing bandicoot.core code.
// Render: dot -Tsvg training-pipeline.dot -o training-pipeline.svg
digraph TrainingPipeline {
    graph [rankdir=LR, newrank=true, bgcolor="#ffffff", pad="0.3",
           nodesep="0.3", ranksep="0.35", labelloc=t, labeljust=l,
           fontname="Helvetica,Arial,sans-serif", fontsize=10, fontcolor="#1f2937"];
    node  [shape=box, style="rounded,filled", penwidth=1.2, margin="0.14,0.08",
           fontname="Helvetica,Arial,sans-serif", fontsize=10, fontcolor="#1f2937",
           fillcolor="#ccfbf1", color="#0f766e"];
    edge  [color="#64748b", penwidth=1.1, arrowsize=0.7,
           fontname="Helvetica,Arial,sans-serif", fontsize=9, fontcolor="#475569"];

    history [shape=cylinder, style=filled, fillcolor="#dbeafe", color="#2563eb",
             label=<<b>History</b><br/><font point-size="9" color="#475569">engagement and<br/>contact logs</font>>];

    extract [label=<<table border="0" cellspacing="1">
        <tr><td align="left"><b>1. Extract</b></td></tr>
        <tr><td align="left"><font point-size="9" color="#475569">build (state, action,</font></td></tr>
        <tr><td align="left"><font point-size="9" color="#475569">next state) rows</font></td></tr>
        <tr><td align="left"><font point-size="9" color="#0f766e">mdp.extract_transitions_from_history</font></td></tr></table>>];
    group [label=<<table border="0" cellspacing="1">
        <tr><td align="left"><b>2. Cluster</b></td></tr>
        <tr><td align="left"><font point-size="9" color="#475569">k-means on passive transition</font></td></tr>
        <tr><td align="left"><font point-size="9" color="#475569">probabilities per participant</font></td></tr>
        <tr><td align="left"><font point-size="9" color="#0f766e">clustering.PassiveBehaviorClusterer</font></td></tr></table>>];
    learn [label=<<table border="0" cellspacing="1">
        <tr><td align="left"><b>3. Learn</b></td></tr>
        <tr><td align="left"><font point-size="9" color="#475569">Dirichlet-smoothed transition</font></td></tr>
        <tr><td align="left"><font point-size="9" color="#475569">counts per cluster</font></td></tr>
        <tr><td align="left"><font point-size="9" color="#0f766e">mdp.TransitionLearner</font></td></tr></table>>];
    score [label=<<table border="0" cellspacing="1">
        <tr><td align="left"><b>4. Score</b></td></tr>
        <tr><td align="left"><font point-size="9" color="#475569">Whittle index per</font></td></tr>
        <tr><td align="left"><font point-size="9" color="#475569">(cluster, state)</font></td></tr>
        <tr><td align="left"><font point-size="9" color="#0f766e">whittle.WhittleIndexSolver</font></td></tr></table>>];
    mapper [style="rounded,filled,dashed", label=<<table border="0" cellspacing="1">
        <tr><td align="left"><b>5. Cold-start mapper</b></td></tr>
        <tr><td align="left"><font point-size="9" color="#475569">enrollment features</font></td></tr>
        <tr><td align="left"><font point-size="9" color="#475569">to cluster</font></td></tr>
        <tr><td align="left"><font point-size="9" color="#475569"><i>planned</i></font></td></tr></table>>];

    store [shape=cylinder, style="filled,dashed", fillcolor="#f1f5f9", color="#64748b",
           label=<<b>Model store</b><br/><font point-size="9" color="#475569">clusters, parameters,<br/>indices (planned)</font>>];

    history -> extract -> group -> learn -> score -> mapper -> store;

    label=<<font point-size="15"><b>Weekly training job</b>  <font point-size="10" color="#64748b">(planned)</font></font><br align="left"/><font point-size="10" color="#64748b">Steps 1 to 4 call existing library code. BandicootRMAB.fit runs them in one call today.</font><br align="left"/>>;
}
